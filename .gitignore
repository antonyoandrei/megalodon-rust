services.json
metadata-settings.json
artwork-choices.json
profile-avatars.json
image-cache/
metadata-api-cache/
inventories/
frames/
art-uploads/
drive/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.lock
!Cargo.lock

