# Configuración opcional. Se lee la conexión de ../megalodon-front/.env.local
# y la clave vigente del launcher (%LOCALAPPDATA%/Megalodon/secrets.json).
# Los valores de este proyecto y del entorno tienen prioridad.
JELLYFIN_BASE_URL=http://localhost:8096
JELLYFIN_API_KEY=
# Perfil: si se omite se usa un administrador habilitado o el primer perfil activo.
JELLYFIN_USER_ID=
MEGALODON_PORT=3210

